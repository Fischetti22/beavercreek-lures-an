<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title }}</title>
  
  {{ content_for_header }}
  
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>
<body style="background: {{ settings.color_background }}; color: {{ settings.color_text }}; margin: 0; font-family: {{ settings.font_body.family }}, sans-serif;">

  <!-- Header -->
  <header style="background: rgba(0,0,0,0.95); border-bottom: 3px solid; border-image: linear-gradient(90deg, {{ settings.color_accent }}, {{ settings.color_pink }}, {{ settings.color_orange }}, {{ settings.color_yellow }}) 1; padding: 15px 20px; position: sticky; top: 0; z-index: 100;">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
      <h1 style="font-family: {{ settings.font_heading.family }}, Impact, sans-serif; color: {{ settings.color_accent }}; margin: 0; font-size: 2rem; letter-spacing: 3px;">
        <a href="/" style="color: {{ settings.color_accent }}; text-decoration: none; text-shadow: 0 0 10px {{ settings.color_accent }};">BEAVERCREEK LURES</a>
      </h1>
      <nav style="display: flex; gap: 30px;">
        <a href="/" style="color: {{ settings.color_text }}; text-decoration: none; font-weight: bold; text-transform: uppercase; transition: color 0.3s;">Home</a>
        <a href="/collections/all" style="color: {{ settings.color_text }}; text-decoration: none; font-weight: bold; text-transform: uppercase; transition: color 0.3s;">Shop</a>
        <a href="/pages/about" style="color: {{ settings.color_text }}; text-decoration: none; font-weight: bold; text-transform: uppercase; transition: color 0.3s;">About</a>
        <a href="/cart" style="color: {{ settings.color_accent }}; text-decoration: none; font-weight: bold; text-transform: uppercase; transition: color 0.3s;">Cart ({{ cart.item_count }})</a>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  <footer style="background: #000; border-top: 2px solid {{ settings.color_accent }}; padding: 40px 20px; text-align: center;">
    <h3 style="font-family: {{ settings.font_heading.family }}, Impact, sans-serif; color: {{ settings.color_accent }}; font-size: 2rem; margin-bottom: 10px;">BEAVERCREEK LURES</h3>
    <p style="color: #888; text-transform: uppercase; letter-spacing: 1px; margin: 10px 0;">Built for the hunt. Designed for the kill.</p>
    <p style="color: #666; font-size: 0.9rem; margin-top: 30px;">&copy; {{ 'now' | date: '%Y' }} Beavercreek Lures. All rights reserved.</p>
  </footer>

</body>
</html>
