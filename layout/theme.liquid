<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Beavercreek Lures - Home of the Camo Frog. Premium handcrafted fishing lures for bass and snakehead. We didn't invent the chase — we perfected the strike.">
  <title>{{ page_title }} | Beavercreek Lures</title>
  <link rel="icon" type="image/jpeg" href="{{ 'logo.jpg' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'logo.jpg' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
</head>
<body>

  <!-- Announcement Bar -->
  <div class="announcement-bar">
    <span>🎣 FREE SHIPPING ON ORDERS OVER $50 &nbsp;|&nbsp; 👑 HOME OF THE CAMO FROG &nbsp;|&nbsp; 🎣 FREE SHIPPING ON ORDERS OVER $50</span>
  </div>

  <!-- Header -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-logo" aria-label="Beavercreek Lures">
        <img class="site-logo-img" src="{{ 'logo.jpg' | asset_url }}" alt="Beavercreek Lures" loading="eager">
      </a>
      
      <nav class="site-nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/collections/all" class="nav-link">Shop</a>
        <a href="/pages/catch-gallery" class="nav-link">Gallery</a>
        <a href="/pages/about" class="nav-link">About</a>
        <a href="/pages/contact" class="nav-link">Contact</a>
        <a href="/cart" class="nav-link nav-cart">Cart {% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}</a>
      </nav>

      <!-- Mobile menu button -->
      <button class="mobile-menu-btn" onclick="document.querySelector('.site-nav').classList.toggle('open')">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <!-- Main Content -->
  <main class="site-main">
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <div class="footer-logo">BEAVERCREEK<span>LURES</span></div>
        <p class="footer-tagline">We didn't invent the chase —<br>we perfected the strike.</p>
        <p class="footer-sub">HOME OF THE CAMO FROG</p>
      </div>
      <div class="footer-links">
        <h4>QUICK LINKS</h4>
        <a href="/collections/all">Shop All Lures</a>
        <a href="/pages/catch-gallery">Catch Gallery</a>
        <a href="/pages/about">About Us</a>
        <a href="/pages/contact">Contact</a>
      </div>
      <div class="footer-links">
        <h4>FOLLOW US</h4>
        <a href="https://www.facebook.com/people/Beavercreek-Lures/61576769684823/" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href="https://www.instagram.com/beavercreek_lures/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://www.tiktok.com/@beavercreek.lures" target="_blank" rel="noopener noreferrer">TikTok</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} Beavercreek Lures. All rights reserved.</p>
    </div>
  </footer>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
