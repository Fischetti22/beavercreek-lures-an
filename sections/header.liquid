<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-logo" aria-label="Beavercreek Lures">
      <img class="site-logo-img" src="{{ 'logo.jpg' | asset_url }}" alt="Beavercreek Lures" loading="eager">
    </a>
    <nav class="site-nav">
      <a href="/" class="nav-link">Home</a>
      <details class="nav-dropdown">
        <summary class="nav-summary">Shop</summary>
        <div class="nav-dropdown-menu">
          <a href="/collections/all/top-water" class="nav-dropdown-link">Top Water</a>
          <a href="/collections/all/sub-surface" class="nav-dropdown-link">Sub-Surface</a>
          <a href="/collections/all/plastic-baits" class="nav-dropdown-link">Plastic Baits</a>
          <a href="/collections/all/saltwater" class="nav-dropdown-link">Saltwater</a>
          <a href="/collections/all/terminal-tackle" class="nav-dropdown-link">Terminal Tackle</a>
          <a href="/collections/all/catfish" class="nav-dropdown-link">Catfish</a>
          <a href="/collections/all/sale" class="nav-dropdown-link" style="color:#ff4444;">🔥 Sale</a>
          <a href="/collections/all/merch" class="nav-dropdown-link">Merch</a>
          <a href="/collections/all" class="nav-dropdown-link">Shop All</a>
        </div>
      </details>
      <a href="/pages/catch-gallery" class="nav-link">Gallery</a>
      <a href="/pages/about" class="nav-link">About</a>
      <a href="/pages/contact" class="nav-link">Contact</a>
      <a href="/cart" class="nav-link nav-cart">Cart {% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}</a>
    </nav>
    <button class="mobile-menu-btn" onclick="document.querySelector('.site-nav').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

{% schema %}
{
  "name": "Header"
}
{% endschema %}
