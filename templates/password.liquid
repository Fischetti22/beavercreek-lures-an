<section class="section section-dark" style="min-height:80vh;display:flex;align-items:center;padding-top:80px;padding-bottom:120px;">
  <div class="section-inner" style="text-align:center;max-width:760px;">
    <img src="{{ 'logo.jpg' | asset_url }}" alt="Beavercreek Lures" style="width:140px;height:auto;margin-bottom:25px;border:2px solid #097D07;border-radius:12px;">
    <p class="section-eyebrow">Launching Soon</p>
    <h1 class="section-title">Beavercreek <span class="accent">Lures</span></h1>
    <p class="section-subtitle" style="margin-bottom:35px;">We're getting the shop dialed in for launch. Enter the storefront password below for early access.</p>

    {% form 'storefront_password' %}
      {% if form.errors %}
        <div style="background:#3b1111;color:#fff;border:2px solid #ff4444;padding:14px;margin-bottom:18px;">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <input type="password" name="password" placeholder="Storefront password" style="min-width:260px;padding:16px;background:#111;border:2px solid #097D07;color:#fff;font-size:1rem;">
        <button type="submit" class="btn-primary" style="border:none;">Enter Store</button>
      </div>
    {% endform %}
  </div>
</section>
