<!-- HOMEPAGE -->

<!-- Hero -->
<section class="hero">
  <div class="hero-bg" style="background-image: url('{{ 'Beavercreek.png' | asset_url }}')"></div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="hero-subtitle">We didn't invent the chase &mdash; we perfected the strike.</p>
    <div class="hero-cta-group">
      <a href="/collections/all" class="btn-primary">Shop Lures</a>
      <a href="/pages/catch-gallery" class="btn-secondary">View Catches</a>
    </div>
  </div>
</section>

<div class="divider"></div>

<!-- Featured Products -->
<section class="section section-dark">
  <div class="section-inner">
    <div class="section-header">
      <p class="section-eyebrow">Proven on the Water</p>
      <h2 class="section-title">Our <span class="accent">Arsenal</span></h2>
      <p class="section-subtitle">Deadly. Proven. Unstoppable.</p>
    </div>
    <div class="product-grid">
      {% for product in collections.all.products limit: 6 %}
        <a href="{{ product.url }}" class="product-card">
          <div class="product-card-image">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title }}" loading="lazy">
            {% else %}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:4rem;color:#097D07;">🎣</div>
            {% endif %}
            <div class="product-card-overlay"><span>VIEW PRODUCT</span></div>
          </div>
          <div class="product-card-info">
            <div class="product-card-title">{{ product.title }}</div>
            <div class="product-card-price">${{ product.price | money_without_currency }}</div>
            {% if product.variants.size > 1 %}
              <div class="product-card-variants">{{ product.variants.size }} Colors Available</div>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
    <div style="text-align:center; margin-top:50px;">
      <a href="/collections/all" class="btn-primary">View All Lures</a>
    </div>
  </div>
</section>

<div class="divider"></div>

<!-- Brand Story -->
<section class="section section-mid">
  <div class="section-inner">
    <div class="brand-story">
      <div class="brand-story-text">
        <p class="section-eyebrow">Who We Are</p>
        <h2>BUILT FOR<br><span class="accent">THE HUNT</span></h2>
        <p>At Beavercreek Lures, we strive to deliver unmatched performance strike after strike. Our lures are designed with one goal in mind: to help you land trophy fish.</p>
        <p>From the iconic Camo Frog to our diverse lineup of proven patterns, each lure is crafted to trigger aggressive strikes in any condition.</p>
        <a href="/pages/about" class="btn-primary" style="margin-top:20px;">Our Story</a>
        <div class="brand-story-logo">
          <img src="{{ 'logo.jpg' | asset_url }}" alt="Beavercreek Lures logo" loading="lazy">
        </div>
      </div>
      <div class="brand-story-image">
        <img src="{{ 'Beavercreek.png' | asset_url }}" alt="Beavercreek Lures - Home of the Camo Frog">
      </div>
    </div>
  </div>
</section>

<div class="divider"></div>

<!-- Catch Gallery Teaser -->
<section class="section section-dark">
  <div class="section-inner">
    <div class="section-header">
      <p class="section-eyebrow">Trophy Catches</p>
      <h2 class="section-title"><span class="accent">Proven</span> Results</h2>
      <p class="section-subtitle">Real anglers. Real fish. Real results.</p>
    </div>
    <div class="gallery-grid">
      {% assign catch_images = 'american_closeup.jpg,closeup.jpg,fullscale.jpg,lure_catch.jpg,portrail_catch.jpg,snakehead.jpg,white_snakehead.jpg,youth_catch.jpg' | split: ',' %}
      {% for img in catch_images %}
        <div class="gallery-item">
          <img src="{{ img | asset_url }}" alt="Beavercreek Lures catch photo" loading="lazy">
        </div>
      {% endfor %}
    </div>
    <div style="text-align:center; margin-top:50px;">
      <a href="/pages/catch-gallery" class="btn-secondary">View Full Gallery</a>
    </div>
  </div>
</section>
