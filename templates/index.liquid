<!-- Hero Section -->
<section style="position: relative; height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: url('{{ 'Beavercreek.png' | asset_img_url: 'master' }}') center/cover;">
  <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.8) 100%);"></div>
  
  <div style="position: relative; z-index: 10; text-align: center; padding: 20px;">
    <h2 style="font-family: {{ settings.font_heading.family }}, Impact, sans-serif; font-size: clamp(3rem, 10vw, 8rem); font-weight: 900; margin: 0; line-height: 0.9; text-transform: uppercase;">
      <span style="display: block; color: {{ settings.color_accent }}; text-shadow: 0 0 10px {{ settings.color_accent }}, 0 0 20px {{ settings.color_accent }}, 0 0 40px {{ settings.color_accent }}, 0 0 80px {{ settings.color_accent }};">BEAVERCREEK</span>
      <span style="display: block; color: {{ settings.color_accent }}; text-shadow: 0 0 10px {{ settings.color_accent }}, 0 0 20px {{ settings.color_accent }}, 0 0 40px {{ settings.color_accent }}, 0 0 80px {{ settings.color_accent }};">LURES</span>
    </h2>
    
    <p style="font-size: clamp(1.2rem, 3vw, 2rem); color: #fff; margin: 30px 0 10px 0; text-transform: uppercase; letter-spacing: 2px; font-weight: bold;">
      HOME OF THE CAMO FROG
    </p>
    
    <p style="font-size: clamp(1rem, 2.5vw, 1.5rem); color: #ccc; margin: 10px 0 40px 0; font-style: italic;">
      We didn't invent the chase — we perfected the strike.
    </p>
    
    <a href="/collections/all" style="display: inline-block; margin-top: 20px; padding: 15px 50px; background: {{ settings.color_accent }}; border: 2px solid {{ settings.color_accent }}; color: #000; text-decoration: none; font-family: {{ settings.font_heading.family }}, Impact, sans-serif; font-size: 1.2rem; text-transform: uppercase; letter-spacing: 2px; transition: all 0.3s; font-weight: bold;">
      SHOP NOW
    </a>
  </div>
</section>

<!-- Announcement Banner -->
<div style="background: {{ settings.color_accent }}; color: #000; text-align: center; padding: 15px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
  🎣 FREE SHIPPING ON ORDERS OVER $50 🎣
</div>

<!-- Product Grid -->
<section style="max-width: 1200px; margin: 60px auto; padding: 0 20px;">
  <h3 style="font-family: {{ settings.font_heading.family }}, Impact, sans-serif; font-size: 3rem; text-align: center; margin-bottom: 10px; text-transform: uppercase;">
    OUR <span style="color: {{ settings.color_accent }};">ARSENAL</span>
  </h3>
  <p style="text-align: center; color: #888; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 40px;">
    Deadly. Proven. Unstoppable.
  </p>
  
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
    {% for product in collections.all.products limit: 6 %}
      <a href="{{ product.url }}" style="text-decoration: none; color: inherit; background: #1a1a1a; border: 1px solid rgba(57, 255, 20, 0.3); overflow: hidden; transition: all 0.3s;">
        <div style="aspect-ratio: 1; background: #000; display: flex; align-items: center; justify-content: center; overflow: hidden;">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: '500x500' }}" alt="{{ product.title }}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;">
          {% else %}
            <span style="font-size: 4rem;">🎣</span>
          {% endif %}
        </div>
        <div style="padding: 20px;">
          <h4 style="font-family: {{ settings.font_heading.family }}, Impact, sans-serif; color: {{ settings.color_accent }}; font-size: 1.5rem; margin: 0 0 10px 0; text-transform: uppercase;">
            {{ product.title }}
          </h4>
          <p style="font-size: 1.2rem; font-weight: bold; margin: 0;">${{ product.price | money_without_currency }}</p>
        </div>
      </a>
    {% endfor %}
  </div>
  
  <div style="text-align: center; margin-top: 40px;">
    <a href="/collections/all" style="display: inline-block; padding: 15px 50px; background: transparent; border: 2px solid {{ settings.color_accent }}; color: {{ settings.color_accent }}; text-decoration: none; font-family: {{ settings.font_heading.family }}, Impact, sans-serif; text-transform: uppercase; letter-spacing: 2px;">
      VIEW ALL LURES
    </a>
  </div>
</section>

<!-- Catch Gallery Section -->
<section style="background: #1a1a1a; padding: 60px 20px;">
  <div style="max-width: 1200px; margin: 0 auto;">
    <h3 style="font-family: {{ settings.font_heading.family }}, Impact, sans-serif; font-size: 3rem; text-align: center; margin-bottom: 40px; text-transform: uppercase;">
      <span style="color: {{ settings.color_accent }};">PROVEN</span> RESULTS
    </h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px;">
      {% comment %} Add your catch photos here {% endcomment %}
      {% for i in (1..8) %}
        <div style="aspect-ratio: 1; background: #000; border: 1px solid rgba(57, 255, 20, 0.2); display: flex; align-items: center; justify-content: center;">
          <span style="font-size: 3rem; opacity: 0.3;">📸</span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
