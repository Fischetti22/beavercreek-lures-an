<section class="section section-dark" style="padding-top:50px;">
  <div class="section-inner">
    <p class="section-eyebrow" style="margin-bottom:15px;">Your Cart</p>
    <h1 style="font-family:'Bebas Neue',Impact,sans-serif;font-size:clamp(3rem,5vw,5rem);color:#fff;margin:0 0 30px 0;">Cart</h1>

    {% if cart.item_count == 0 %}
      <div style="background:#0b0b0b;border:2px solid #222;padding:35px;text-align:center;">
        <h2 style="font-family:'Bebas Neue',Impact,sans-serif;font-size:2.5rem;color:#fff;margin:0 0 10px 0;">Your cart is empty</h2>
        <p style="color:#aaa;font-family:'Barlow',sans-serif;margin:0 0 25px 0;">Add a few Beavercreek Lures and come back when you're ready to checkout.</p>
        <a href="/collections/all" class="btn-primary" style="display:inline-block;text-decoration:none;padding:14px 28px;">Shop All Lures</a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div style="display:grid;gap:18px;">
          {% for item in cart.items %}
            <div style="display:grid;grid-template-columns:110px 1fr auto;gap:18px;align-items:center;background:#0b0b0b;border:2px solid #222;padding:16px;">
              <a href="{{ item.url }}" style="display:block;">
                {% if item.image %}
                  <img src="{{ item.image | img_url: '220x220' }}" alt="{{ item.product.title | escape }}" style="width:110px;height:110px;object-fit:cover;border:2px solid #097D07;">
                {% endif %}
              </a>

              <div>
                <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:1.6rem;color:#fff;margin:0 0 6px 0;">
                  <a href="{{ item.url }}" style="color:#fff;text-decoration:none;">{{ item.product.title }}</a>
                </h2>
                {% unless item.product.has_only_default_variant %}
                  <p style="color:#888;margin:0 0 10px 0;font-family:'Barlow',sans-serif;">{{ item.variant.title }}</p>
                {% endunless %}
                <p style="color:#097D07;margin:0 0 12px 0;font-family:'Bebas Neue',sans-serif;font-size:1.6rem;">{{ item.final_price | money }}</p>
                <label for="updates_{{ item.key }}" style="display:block;color:#aaa;font-family:'Barlow Condensed',sans-serif;font-weight:700;letter-spacing:2px;font-size:0.8rem;margin-bottom:6px;">QTY</label>
                <input id="updates_{{ item.key }}" name="updates[]" type="number" value="{{ item.quantity }}" min="0" style="width:80px;padding:10px;background:#111;border:2px solid #333;color:#fff;font-size:1rem;text-align:center;">
              </div>

              <div style="text-align:right;">
                <p style="color:#fff;margin:0 0 14px 0;font-family:'Bebas Neue',sans-serif;font-size:1.8rem;">{{ item.final_line_price | money }}</p>
                <a href="{{ item.url_to_remove }}" style="color:#888;font-family:'Barlow',sans-serif;font-size:0.9rem;">Remove</a>
              </div>
            </div>
          {% endfor %}
        </div>

        <div style="margin-top:30px;background:#0b0b0b;border:2px solid #097D07;padding:24px;display:grid;gap:18px;justify-items:end;">
          <div style="font-family:'Bebas Neue',sans-serif;font-size:2.2rem;color:#fff;">
            Subtotal: <span style="color:#097D07;">{{ cart.total_price | money }}</span>
          </div>
          <p style="color:#888;margin:0;font-family:'Barlow',sans-serif;text-align:right;">Shipping and taxes are calculated at checkout.</p>
          <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:flex-end;">
            <button type="submit" name="update" style="padding:14px 24px;background:#111;border:2px solid #333;color:#fff;font-family:'Barlow Condensed',sans-serif;font-weight:800;letter-spacing:1px;cursor:pointer;">Update Cart</button>
            <button type="submit" name="checkout" class="btn-primary" style="padding:14px 32px;border:none;cursor:pointer;">Checkout</button>
          </div>
        </div>
      </form>
    {% endif %}
  </div>
</section>
