<div style="max-width: 1000px; margin: 60px auto; padding: 0 20px;">
  <!-- Page Header -->
  <div style="text-align: center; padding: 60px 20px; background: linear-gradient(135deg, #1a1a1a, #000); border: 3px solid; border-image: linear-gradient(90deg, {{ settings.color_accent }}, {{ settings.color_pink }}, {{ settings.color_orange }}, {{ settings.color_yellow }}) 1; margin-bottom: 60px;">
    <h1 style="font-family: {{ settings.font_heading.family }}, Impact, sans-serif; color: {{ settings.color_accent }}; font-size: 4rem; margin: 0; text-transform: uppercase; text-shadow: 0 0 20px {{ settings.color_accent }};">
      {{ page.title }}
    </h1>
  </div>
  <div style="line-height: 1.8; font-size: 1.1rem; color: #ddd; background: #1a1a1a; padding: 50px; border-radius: 10px;">
    {{ page.content }}
  </div>
</div>
