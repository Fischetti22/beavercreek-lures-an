<div style="max-width: 1200px; margin: 60px auto; padding: 0 20px;">
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px;">
    
    <!-- Product Image -->
    <div>
      {% if product.featured_image %}
        <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" style="width: 100%; border: 2px solid {{ settings.color_accent }};">
      {% endif %}
      
      <!-- Thumbnail Images -->
      {% if product.images.size > 1 %}
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 20px;">
          {% for image in product.images %}
            <img src="{{ image | img_url: '200x200' }}" alt="{{ product.title }}" style="width: 100%; cursor: pointer; border: 1px solid #333;">
          {% endfor %}
        </div>
      {% endif %}
    </div>
    
    <!-- Product Info -->
    <div>
      <h1 style="font-family: {{ settings.font_heading.family }}, Impact, sans-serif; color: {{ settings.color_accent }}; font-size: 3rem; margin: 0 0 20px 0; text-transform: uppercase;">
        {{ product.title }}
      </h1>
      
      <p style="font-size: 2rem; font-weight: bold; margin-bottom: 30px;">
        ${{ product.price | money_without_currency }}
      </p>
      
      <div style="color: #ccc; line-height: 1.6; margin-bottom: 40px;">
        {{ product.description }}
      </div>
      
      {% form 'product', product %}
        <!-- Variant Selector -->
        {% if product.variants.size > 1 %}
          <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 10px; font-weight: bold; text-transform: uppercase;">Color:</label>
            <select name="id" style="width: 100%; padding: 15px; background: #1a1a1a; border: 2px solid {{ settings.color_accent }}; color: #fff; font-size: 1rem;">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% if variant.available == false %}disabled{% endif %}>
                  {{ variant.title }} - ${{ variant.price | money_without_currency }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        {% endif %}
        
        <!-- Quantity -->
        <div style="margin-bottom: 30px;">
          <label style="display: block; margin-bottom: 10px; font-weight: bold; text-transform: uppercase;">Quantity:</label>
          <input type="number" name="quantity" value="1" min="1" style="width: 100px; padding: 15px; background: #1a1a1a; border: 2px solid {{ settings.color_accent }}; color: #fff; font-size: 1rem;">
        </div>
        
        <!-- Add to Cart Button -->
        <button type="submit" style="width: 100%; padding: 20px; background: {{ settings.color_accent }}; color: #000; border: none; font-family: {{ settings.font_heading.family }}, Impact, sans-serif; font-size: 1.5rem; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.3s;">
          ADD TO CART
        </button>
      {% endform %}
    </div>
    
  </div>
</div>
