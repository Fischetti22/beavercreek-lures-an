<div style="max-width: 1200px; margin: 60px auto; padding: 0 20px;">
  
  <h1 style="font-family: {{ settings.font_heading.family }}, Impact, sans-serif; font-size: 4rem; text-align: center; margin-bottom: 10px; text-transform: uppercase;">
    <span style="color: {{ settings.color_accent }};">{{ collection.title }}</span>
  </h1>
  
  <p style="text-align: center; color: #888; margin-bottom: 60px;">
    {{ collection.description }}
  </p>
  
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px;">
    {% for product in collection.products %}
      <a href="{{ product.url }}" style="text-decoration: none; color: inherit; background: #1a1a1a; border: 1px solid rgba(57, 255, 20, 0.3); overflow: hidden; transition: all 0.3s;">
        <div style="aspect-ratio: 1; background: #000; display: flex; align-items: center; justify-content: center; overflow: hidden;">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: '500x500' }}" alt="{{ product.title }}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;">
          {% else %}
            <span style="font-size: 4rem; color: {{ settings.color_accent }};">🎣</span>
          {% endif %}
        </div>
        <div style="padding: 20px;">
          <h3 style="font-family: {{ settings.font_heading.family }}, Impact, sans-serif; color: {{ settings.color_accent }}; font-size: 1.5rem; margin: 0 0 10px 0; text-transform: uppercase;">
            {{ product.title }}
          </h3>
          <p style="font-size: 1.2rem; font-weight: bold; margin: 0;">${{ product.price | money_without_currency }}</p>
          {% if product.variants.size > 1 %}
            <p style="font-size: 0.9rem; color: #888; margin-top: 5px;">{{ product.variants.size }} colors</p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
  
  {% if paginate.pages > 1 %}
    <div style="text-align: center; margin-top: 60px;">
      {{ paginate | default_pagination }}
    </div>
  {% endif %}
  
</div>
