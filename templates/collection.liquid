{% assign type_filter = '' %}
{% assign type_label = collection.title %}
{% if request.path contains '/top-water' or request.path contains '/topwater' %}
  {% assign type_filter = 'top-water' %}
  {% assign type_label = 'Top Water' %}
{% elsif request.path contains '/saltwater' %}
  {% assign type_filter = 'saltwater' %}
  {% assign type_label = 'Saltwater' %}
{% elsif request.path contains '/sub-surface' %}
  {% assign type_filter = 'sub-surface' %}
  {% assign type_label = 'Sub-Surface' %}
{% elsif request.path contains '/plastic-baits' %}
  {% assign type_filter = 'plastic-baits' %}
  {% assign type_label = 'Plastic Baits' %}
{% elsif request.path contains '/merch' %}
  {% assign type_filter = 'merch' %}
  {% assign type_label = 'Merch' %}
{% elsif request.path contains '/terminal-tackle' %}
  {% assign type_filter = 'terminal-tackle' %}
  {% assign type_label = 'Terminal Tackle' %}
{% endif %}

<section class="section section-dark" style="padding-top:50px;">
  <div class="section-inner">
    <div class="section-header">
      <p class="section-eyebrow">Beavercreek Lures</p>
      <h1 class="section-title"><span class="accent">{{ type_label }}</span></h1>
      {% if collection.description != blank and type_filter == '' %}
        <p class="section-subtitle">{{ collection.description }}</p>
      {% else %}
        <p class="section-subtitle">Deadly. Proven. Unstoppable.</p>
      {% endif %}
    </div>
    <div class="product-grid">
      {% for product in collection.products %}
        {% assign show_product = true %}
        {% if type_filter != '' %}
          {% assign show_product = false %}
          {% for tag in product.tags %}
            {% assign tag_handle = tag | handleize %}
            {% if tag_handle == type_filter %}
              {% assign show_product = true %}
            {% elsif type_filter == 'top-water' and tag_handle == 'topwater' %}
              {% assign show_product = true %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if show_product %}
        <a href="{{ product.url }}" class="product-card">
          <div class="product-card-image">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title }}" loading="lazy">
            {% else %}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:4rem;color:#097D07;">🎣</div>
            {% endif %}
            <div class="product-card-overlay"><span>VIEW PRODUCT</span></div>
          </div>
          <div class="product-card-info">
            <div class="product-card-title">{{ product.title }}</div>
            <div class="product-card-price">${{ product.price | money_without_currency }}</div>
            {% if product.variants.size > 1 %}
              <div class="product-card-variants">{{ product.variants.size }} Options Available</div>
            {% endif %}
          </div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      <div style="text-align:center;margin-top:50px;">{{ paginate | default_pagination }}</div>
    {% endif %}
  </div>
</section>
